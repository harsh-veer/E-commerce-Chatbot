# Database Configuration
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=ecommerce_bot

# Security / Authentication
JWT_SECRET=your_production_secret_key_change_me

# CORS Configuration (comma-separated origins allowed to access backend)
CORS_ORIGINS=http://localhost:3000,http://localhost:80,https://yourdomain.com

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
